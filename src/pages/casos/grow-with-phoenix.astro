---
/* ═══════════════════════════════════════════════════════════
   CASO · GROW WITH PHOENIX  →  /Portafolio/casos/grow-with-phoenix

   ── DÓNDE ESTÁ TODO LO DE ESTA PÁGINA ──────────────────────
   contenido   src/content/casos/grow-with-phoenix.ts   ← TODO el texto
   interfaz    src/i18n/{es,en}/casos.ts                ← la barra
   estilo      src/styles/casos/caso.css   (compartida con el otro caso)
               └ partes/lectura.css, barra.css y las de cada bloque
   scripts     src/scripts/casos/barra.ts · diagnostico.ts · escritura.ts
   piezas      src/components/paginas/casos/
   imágenes    originales/images/casos/grow-with-phoenix/ → manifiesto
   URL previa  /pages/caso/grow-with-phoenix.html → redirige

   ── EL LAYOUT ──────────────────────────────────────────────
   El de todos los casos desde 2026-10, el mismo de Schaman: una barra
   propia a la izquierda (el índice, con su mascota, el idioma y el
   saludo) y el contenido hasta el margen derecho. Seis secciones,
   00–05, cada una con su acento (--caso-acento):

     00 portada      --pink-light  03 propuesta    --mint
     01 problema     --peach       04 pantallas    --lav
     02 investigación --sky        05 lo que viene --yellow

   LO FIJO. Los gráficos de la investigación y las pantallas del
   prototipo van en PantallasFijas: la columna de la imagen se queda
   quieta y cada llamada trae la suya. Las pantallas son pares de
   teléfonos con su propio marco, así que van sin borde (sinMarco).

   ── LAS IMÁGENES ───────────────────────────────────────────
   Por el manifiesto, como pide CONVENCIONES §4: los originales están
   en originales/images/casos/grow-with-phoenix/ (y sus carpetas
   investigacion/ y pantallas/), npm run imagenes genera lo publicado y
   captura() pide cada una por su nombre, sin extensión.
   ═══════════════════════════════════════════════════════════ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Texto from '../../components/piezas/Texto.astro';
import BarraDeCaso from '../../components/paginas/casos/BarraDeCaso.astro';
import EncabezadoDeSeccion from '../../components/paginas/casos/EncabezadoDeSeccion.astro';
import FichaDePortada from '../../components/paginas/casos/FichaDePortada.astro';
import VentanaDeCaso from '../../components/paginas/casos/VentanaDeCaso.astro';
import NotaConMascota from '../../components/paginas/casos/NotaConMascota.astro';
import PreguntaDeDiseno from '../../components/paginas/casos/PreguntaDeDiseno.astro';
import SubBloqueDeCaso from '../../components/paginas/casos/SubBloqueDeCaso.astro';
import TiraDeTres from '../../components/paginas/casos/TiraDeTres.astro';
import PantallasFijas from '../../components/paginas/casos/PantallasFijas.astro';
import CierreDeCaso from '../../components/paginas/casos/CierreDeCaso.astro';
import { rutaPagina } from '../../lib/rutas';
import { imagen } from '../../lib/imagenes';
import { growWithPhoenix as contenido } from '../../content/casos/grow-with-phoenix';
import '../../styles/casos/caso.css';

const EN_DRIVE =
  'https://drive.google.com/file/d/14QEug3cvbm_SLL2dG_udZX4H6NDujfX7/view?usp=sharing';
const PROYECTOS = rutaPagina('proyectos');

/* Cada captura, con el ancho y el alto REALES de su archivo, que salen
   del manifiesto. 1704 es el doble de la columna de contenido; ninguna
   de estas llega, así que se quedan como están. */
const captura = (nombre: string) => {
  const { src, ancho, alto } = imagen('images/casos/grow-with-phoenix/' + nombre, 1704);
  return { imagen: src, ancho, alto };
};

const ACENTO = {
  portada: 'var(--pink-light)', problema: 'var(--peach)', investigacion: 'var(--sky)',
  propuesta: 'var(--mint)', pantallas: 'var(--lav)', loQueViene: 'var(--yellow)',
} as const;

const { indice, portada, problema, investigacion, propuesta, pantallas, loQueViene } = contenido;
const { acceso, ambiente, clima, plantas, fuentes } = investigacion;

/* LAS PARADAS DE LA BARRA: una por sección. La 02 lleva su sub-índice. */
const PARADAS = [
  { id: 'caso-00', acento: ACENTO.portada },
  { id: 'caso-01', acento: ACENTO.problema },
  { id: 'caso-02', acento: ACENTO.investigacion, sub: [acceso, ambiente, clima, plantas, fuentes].map((bloque, j) => ({ id: `caso-02-${j + 1}`, nombre: bloque.corto })) },
  { id: 'caso-03', acento: ACENTO.propuesta },
  { id: 'caso-04', acento: ACENTO.pantallas },
  { id: 'caso-05', acento: ACENTO.loQueViene },
].map((parada, i) => ({ ...parada, ...indice[i]! }));

/* LA PORTADA, EN DOS COLUMNAS: la ventana y la ficha a su lado. */
const VENTANA = captura('00-mockup');

/* Los gráficos de cada sub-bloque de la investigación, en el orden de
   sus textos en el contenido. Una llamada por gráfico: «Título · pie». */
const fijos = (archivos: readonly string[], textos: readonly { titulo: unknown; pie: unknown; alt: unknown }[]) =>
  archivos.map((archivo, i) => {
    const { titulo, pie, alt } = textos[i] as (typeof acceso.mapas)[number];
    return { imagenes: [{ ...captura('investigacion/' + archivo), alt }], titulo, pie };
  });
const MAPAS_DE_ACCESO = fijos(['mapa-desiertos', 'mapa-bajos-ingresos'], acceso.mapas);
const MAPAS_DE_AMBIENTE = fijos(['mapa-analisis-agricola', 'detalle-vegetacion', 'detalle-evapotranspiracion'], ambiente.mapas);
const GRAFICOS_DE_CLIMA = fijos(['precipitacion-anual', 'precipitacion-categorias', 'precipitacion-mensual', 'temperatura-mensual', 'temperatura-estaciones'], clima.graficos);

/* los diez conjuntos de datos que documenta la presentación. No se
   traducen: son nombres de colecciones de Google Earth Engine. */
const FUENTES_DE_DATOS = [
  ['Census · ACS', 'TIGER/2010/Tracts_DP1'],
  ['Cobertura del suelo · NLCD', 'USGS/NLCD_RELEASES/2019_REL/NLCD/2019'],
  ['Población · CIESIN', 'CIESIN/GPWv411/GPW_Population_Count'],
  ['Límites administrativos', 'TIGER/2018/Counties'],
  ['Precipitación · CHIRPS', 'UCSB-CHG/CHIRPS/PENTAD'],
  ['Vegetación · Sentinel-2', 'COPERNICUS/S2_SR'],
  ['Humedad del suelo · SMAP', 'NASA_USDA/HSL/SMAP_soil_moisture'],
  ['Cultivos · USDA NASS', 'USDA/NASS/CDL'],
  ['Temperatura · MODIS', 'MODIS/061/MOD11A2'],
  ['Evapotranspiración · MODIS', 'MODIS/006/MOD16A2'],
] as const;

/* LAS PANTALLAS: cinco grupos de dos, en el orden de sus textos. Cada
   llamada trae el par de teléfonos con su pie y, a la derecha, el
   título y los dos párrafos del grupo. */
const PARES = [
  ['pagina-carga', 'pagina-inicio'],
  ['pagina-estadistica', 'pagina-ensalada'],
  ['pagina-menuescanear', 'pagina-escaneo'],
  ['pagina-leaderboard', 'pagina-perfil'],
  ['pagina-notificacion', 'pagina-widget'],
] as const;
const GRUPOS_DE_PANTALLAS = pantallas.grupos.map((grupo, i) => ({
  titulo: grupo.titulo,
  parrafos: grupo.parrafos,
  imagenes: PARES[i]!.map((archivo, j) => ({ ...captura('pantallas/' + archivo), ...grupo.pantallas[j]! })),
}));
---

<BaseLayout
  paginaActual="projects"
  paginaDeDatos="caso"
  claveTitulo="pages.projects.metaTitle"
  claveDescripcion="pages.projects.metaDescription"
  nombreDeVentana={contenido.documento.nombreDeVentana}
  claseBody="cs-body"
  tituloDelCaso={contenido.documento}
  sinTaskbar
>
  <div class="caso-pagina">

    <BarraDeCaso paradas={PARADAS} volver={PROYECTOS} saludo={portada.saludo} />

    <div class="caso-contenido">

      {/* ══ 00 · PORTADA ══ */}
      <header class="caso-portada" id="caso-00" style={`--caso-acento:${ACENTO.portada}`}>
        <Texto class="caso-antetitulo hx" style="--d:100ms" valor={portada.antetitulo} />
        <h1 class="caso-h1 hx" style="--d:170ms" data-escribir>Grow With Phoenix</h1>
        <Texto class="caso-subtitulo hx" style="--d:240ms" valor={portada.subtitulo} />
        <div class="caso-portada-fila hx" style={`--d:300ms;--proporcion:${VENTANA.ancho} / ${VENTANA.alto}`}>
          <VentanaDeCaso nombre={portada.ventana.nombre} {...VENTANA} alt={portada.ventana.alt} pie={portada.ventana.pie} />
          <FichaDePortada campos={portada.ficha} />
        </div>
        <Texto html class="caso-texto cs-rv" valor={portada.introduccion} />
        <TiraDeTres elementos={portada.miRol} />
        <Texto html class="caso-texto cs-rv" valor={portada.equipo} />
      </header>

      {/* ══ 01 · EL PROBLEMA ══ */}
      <section class="caso-seccion" id="caso-01" style={`--caso-acento:${ACENTO.problema}`} aria-labelledby="h-caso-01">
        <EncabezadoDeSeccion id="h-caso-01" antetitulo={problema.antetitulo} titulo={problema.titulo} />
        {problema.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
        <PreguntaDeDiseno rotulo={problema.pregunta.rotulo} texto={problema.pregunta.texto} />
      </section>

      {/* ══ 02 · LA INVESTIGACIÓN · cinco sub-bloques ══ */}
      <section class="caso-seccion" id="caso-02" style={`--caso-acento:${ACENTO.investigacion}`} aria-labelledby="h-caso-02">
        <EncabezadoDeSeccion id="h-caso-02" antetitulo={investigacion.antetitulo} titulo={investigacion.titulo} />
        <Texto html class="caso-texto cs-rv" valor={investigacion.entrada} />

        <SubBloqueDeCaso id="caso-02-1" numero={1} total={5} titulo={acceso.titulo}>
          <Texto class="caso-texto cs-rv" valor={acceso.parrafo} />
          <PantallasFijas pantallas={MAPAS_DE_ACCESO} />
          <Texto class="caso-aparte cs-rv" valor={acceso.nota} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-02-2" numero={2} total={5} titulo={ambiente.titulo}>
          <Texto class="caso-texto cs-rv" valor={ambiente.parrafo} />
          <PantallasFijas pantallas={MAPAS_DE_AMBIENTE} />
          {/* la conclusión de los tres mapas */}
          <Texto como="blockquote" class="caso-cita cs-rv" valor={ambiente.nota} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-02-3" numero={3} total={5} titulo={clima.titulo}>
          <Texto class="caso-texto cs-rv" valor={clima.parrafo} />
          <PantallasFijas pantallas={GRAFICOS_DE_CLIMA} />
          {/* la ficha del último gráfico, el de invierno y verano */}
          <div class="cs-rv"><FichaDePortada campos={clima.fichaDeVariable} /></div>
          <Texto class="caso-aparte cs-rv" valor={clima.nota} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-02-4" numero={4} total={5} titulo={plantas.titulo}>
          <Texto class="caso-texto cs-rv" valor={plantas.parrafo} />
          <NotaConMascota variante="aviso" rotulo={plantas.aviso.rotulo} texto={plantas.aviso.texto} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-02-5" numero={5} total={5} titulo={fuentes.titulo}>
          <Texto class="caso-texto cs-rv" valor={fuentes.parrafo} />
          <ul class="caso-fuentes cs-rv">{FUENTES_DE_DATOS.map(([nombre, coleccion]) => (
            <li>{nombre}<code>{coleccion}</code></li>
          ))}</ul>
        </SubBloqueDeCaso>
      </section>

      {/* ══ 03 · DEL ENTORNO AL PLATO ══ */}
      <section class="caso-seccion" id="caso-03" style={`--caso-acento:${ACENTO.propuesta}`} aria-labelledby="h-caso-03">
        <EncabezadoDeSeccion id="h-caso-03" antetitulo={propuesta.antetitulo} titulo={propuesta.titulo} />
        <Texto html class="caso-texto cs-rv" valor={propuesta.parrafo} />
        <TiraDeTres variante="acento" elementos={propuesta.momentos} />
        <Texto como="h3" class="caso-h3 cs-rv" valor={propuesta.gamificacion.titulo} />
        <Texto class="caso-texto cs-rv" valor={propuesta.gamificacion.parrafo} />
        <Texto class="caso-aparte cs-rv" valor={propuesta.nota} />
      </section>

      {/* ══ 04 · LAS PANTALLAS · fijas, de dos en dos ══ */}
      <section class="caso-seccion" id="caso-04" style={`--caso-acento:${ACENTO.pantallas}`} aria-labelledby="h-caso-04">
        <EncabezadoDeSeccion id="h-caso-04" antetitulo={pantallas.antetitulo} titulo={pantallas.titulo} />
        {pantallas.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
        <PantallasFijas sinMarco pantallas={GRUPOS_DE_PANTALLAS} />
      </section>

      {/* ══ 05 · LO QUE VIENE ══ */}
      <section class="caso-seccion" id="caso-05" style={`--caso-acento:${ACENTO.loQueViene}`} aria-labelledby="h-caso-05">
        <EncabezadoDeSeccion id="h-caso-05" antetitulo={loQueViene.antetitulo} titulo={loQueViene.titulo} />
        {loQueViene.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
      </section>

      {/* el cierre de siempre: volver, el proyecto y los otros proyectos */}
      <div class="cs-rv">
        <CierreDeCaso
          texto={contenido.cierre}
          enlaceDelProyecto={EN_DRIVE}
          claseDelBoton="btn btn-yellow"
          relacionados={[
            /* interno: es otra página del sitio, así que NO abre pestaña nueva */
            { nombre: 'Schaman Analytics BI', meta: 'Rediseño de Interfaz · 2026',
              enlace: rutaPagina('casos/schaman-analytics-bi'),
              imagen: imagen('images/proyectos/schaman-analytics', 416).src,
              interno: true },
            { nombre: 'Catventures', meta: 'Unity 2D · 2026',
              enlace: 'https://github.com/bypaupau/JuegoGrupal-ProyectoIIParcial',
              imagen: imagen('images/proyectos/catventures', 416).src },
          ]}
        />
      </div>

    </div>
  </div>

  <script>
    import '../../scripts/casos/barra';
    import '../../scripts/casos/nav-al-leer';
    import '../../scripts/casos/escritura';
    import '../../scripts/casos/portada';
    import '../../scripts/casos/diagnostico';
  </script>
</BaseLayout>
