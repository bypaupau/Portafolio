---
/* ═══════════════════════════════════════════════════════════
   CASO · GROW WITH PHOENIX  →  /Portafolio/casos/grow-with-phoenix

   ── DÓNDE ESTÁ TODO LO DE ESTA PÁGINA ──────────────────────
   contenido   src/content/casos/grow-with-phoenix.ts   ← TODO el texto
   estilo      src/styles/casos/caso.css    (compartida con el otro caso)
   script      src/scripts/casos/riel.ts    (compartido)
   piezas      src/components/paginas/casos/        (riel, figura, nota, grupo, cierre)
   imágenes    public/images/casos/grow-with-phoenix/
   URL previa  /pages/caso/grow-with-phoenix.html → redirige

   ── LO QUE MÁS CAMBIA RESPECTO AL SITIO ANTERIOR ───────────
   El HTML anterior salía VACÍO: 150 elementos con data-i18n sin una
   palabra dentro, y JavaScript los llenaba al cargar. Sin JavaScript no
   se leía nada. Ahora Astro escribe el español al compilar y deja el
   inglés en atributos, así que el caso se lee completo sin JavaScript y
   el cambio de idioma sigue siendo instantáneo.

   Y las claves opacas se fueron: lo que era phx.f.rol.3 ahora es
   contenido.miRol.puntos[2]; phx.s2.c.f5.alt es
   contenido.investigacion.clima.inviernoVerano.alt.

   ── POR QUÉ ESTE CASO TIENE SU PROPIO ARCHIVO ──────────────
   Los dos casos comparten el riel, la hoja de estilo y las piezas
   chicas, pero NO la estructura: este tiene cinco secciones con sus
   propias rejillas (dos mapas, un panel, pares con proporciones a
   medida, una ficha de variable al lado de un gráfico). Meterlos en una
   plantilla común obligaría a describir esas rejillas con opciones, y
   sería más difícil de leer que esto.
   ═══════════════════════════════════════════════════════════ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Texto from '../../components/piezas/Texto.astro';
import RielDeCaso from '../../components/paginas/casos/RielDeCaso.astro';
import FiguraDeCaso from '../../components/paginas/casos/FiguraDeCaso.astro';
import GrupoDePantallas from '../../components/paginas/casos/GrupoDePantallas.astro';
import NotaDeCaso from '../../components/paginas/casos/NotaDeCaso.astro';
import CierreDeCaso from '../../components/paginas/casos/CierreDeCaso.astro';
import { conIdioma, altConIdioma, htmlConIdioma } from '../../lib/texto-bilingue';
import { rutaPublica, rutaPagina } from '../../lib/rutas';
import { imagen } from '../../lib/imagenes';
import { growWithPhoenix as contenido } from '../../content/casos/grow-with-phoenix';
import '../../styles/casos/caso.css';

const EN_DRIVE =
  'https://drive.google.com/file/d/14QEug3cvbm_SLL2dG_udZX4H6NDujfX7/view?usp=sharing';

/* las imágenes y sus medidas. El texto va en el contenido; aquí, el
   archivo y el tamaño, que es lo que decide cómo se ve la rejilla. */
const img = (archivo: string) => rutaPublica('images/casos/grow-with-phoenix/' + archivo);

const portada = conIdioma(contenido.portada.antetitulo);
const subtitulo = conIdioma(contenido.portada.subtitulo);
const introduccion = conIdioma(contenido.portada.introduccion);
const avisoEnCurso = conIdioma(contenido.portada.avisoEnCurso);

/* los diez conjuntos de datos que documenta la presentación. No se
   traducen: son nombres de colecciones de Google Earth Engine. */
const fuentesDeDatos = [
  ['Census · ACS', 'TIGER/2010/Tracts_DP1'],
  ['Cobertura del suelo · NLCD', 'USGS/NLCD_RELEASES/2019_REL/NLCD/2019'],
  ['Población · CIESIN', 'CIESIN/GPWv411/GPW_Population_Count'],
  ['Límites administrativos', 'TIGER/2018/Counties'],
  ['Precipitación · CHIRPS', 'UCSB-CHG/CHIRPS/PENTAD'],
  ['Vegetación · Sentinel-2', 'COPERNICUS/S2_SR'],
  ['Humedad del suelo · SMAP', 'NASA_USDA/HSL/SMAP_soil_moisture'],
  ['Cultivos · USDA NASS', 'USDA/NASS/CDL'],
  ['Temperatura · MODIS', 'MODIS/061/MOD11A2'],
  ['Evapotranspiración · MODIS', 'MODIS/006/MOD16A2'],
] as const;

/* los cinco grupos de pantallas: lado, color y las dos capturas */
const gruposDePantallas = [
  {
    id: 'gA', lado: 'g-side', color: 'var(--peach)',
    capturas: [
      { imagen: img('pantallas/pagina-carga.webp'), ancho: 720, alto: 1436, clase: 'is-side' },
      { imagen: img('pantallas/pagina-inicio.webp'), ancho: 720, alto: 1436, clase: 'is-lead' },
    ],
  },
  {
    id: 'gB', lado: 'g-rev', color: 'var(--mint)',
    capturas: [
      { imagen: img('pantallas/pagina-estadistica.webp'), ancho: 720, alto: 1409 },
      { imagen: img('pantallas/pagina-ensalada.webp'), ancho: 720, alto: 1409 },
    ],
  },
  {
    id: 'gC', lado: 'g-side', color: 'var(--sky)',
    capturas: [
      { imagen: img('pantallas/pagina-menuescanear.webp'), ancho: 720, alto: 1436 },
      { imagen: img('pantallas/pagina-escaneo.webp'), ancho: 720, alto: 1400 },
    ],
  },
  {
    id: 'gD', lado: 'g-side', color: 'var(--yellow)',
    capturas: [
      { imagen: img('pantallas/pagina-leaderboard.webp'), ancho: 720, alto: 1384 },
      { imagen: img('pantallas/pagina-perfil.webp'), ancho: 720, alto: 1412 },
    ],
  },
  {
    id: 'gE', lado: 'g-rev', color: 'var(--pink-light)',
    capturas: [
      { imagen: img('pantallas/pagina-notificacion.webp'), ancho: 720, alto: 1438 },
      { imagen: img('pantallas/pagina-widget.webp'), ancho: 688, alto: 1440 },
    ],
  },
] as const;
---

<BaseLayout
  paginaActual="projects"
  paginaDeDatos="caso"
  claveTitulo="pages.projects.metaTitle"
  claveDescripcion="pages.projects.metaDescription"
  nombreDeVentana={contenido.documento.nombreDeVentana}
  claseBody="cs-body"
  tituloDelCaso={contenido.documento}
>
  <div class="wrap">
    <div class="cs-grid">

      <RielDeCaso
        portada={contenido.riel.portada}
        paradas={contenido.riel.paradas}
        salida={{ texto: contenido.riel.verProyecto, enlace: EN_DRIVE }}
      />

      <div class="cs-main">

        {/* ══ PORTADA ══ */}
        <header class="cs-hero" id="cs-portada" style="--cs:var(--pink-mid)">
          <div class="cs-hero-top">
            <div>
              <Texto class="cs-kicker hx" style="--d:100ms" valor={contenido.portada.antetitulo} />
              <h1 class="cs-title hx" style="--d:170ms">Grow With Phoenix</h1>
              <Texto class="cs-sub hx" style="--d:240ms" valor={contenido.portada.subtitulo} />
              <Texto class="cs-text hx" style="--d:300ms" valor={contenido.portada.introduccion} />
              <p class="hx cs-wip-row" style="--d:360ms">
                <span class="cs-wip"><i aria-hidden="true"></i><Texto como="span" valor={contenido.portada.avisoEnCurso} /></span>
              </p>
            </div>
            <figure class="cs-hero-fig hx" style="--d:420ms">
              <img
                src={img('00-mockup.webp')}
                width="1592" height="892" loading="eager" decoding="async"
                {...altConIdioma(contenido.portada.imagen.alt)}
              />
              <Texto como="figcaption" valor={contenido.portada.imagen.pie} />
            </figure>
          </div>

          {/* dos protagonistas: lo que hice y con qué */}
          <dl class="cs-stars cs-rv">
            <div class="cs-star st-rol">
              <Texto como="dt" valor={contenido.miRol.etiqueta} />
              <dd><ul>{contenido.miRol.puntos.map((punto) => <Texto como="li" valor={punto} />)}</ul></dd>
            </div>
            <div class="cs-star st-win">
              <Texto como="dt" valor={contenido.herramientas.etiqueta} />
              <dd><ul>{contenido.herramientas.puntos.map((punto) => {
                const p = htmlConIdioma(punto);
                return <li {...p.atributos} set:html={p.texto} />;
              })}</ul></dd>
            </div>
          </dl>

          {/* ficha compacta: contexto, premio, equipo y estado */}
          <dl class="cs-rows cs-rv">{contenido.ficha.map((fila) => {
            const etiqueta = conIdioma(fila.etiqueta);
            const valor = conIdioma(fila.valor);
            return (
              <div class="cs-row"><dt {...etiqueta.atributos}>{etiqueta.texto}</dt><dd {...valor.atributos}>{valor.texto}</dd></div>
            );
          })}</dl>
        </header>

        {/* ══ 01 · EL PROBLEMA ══ */}
        <section class="cs-sec" id="cs-1" style="--cs:var(--peach)" aria-labelledby="h-cs-1">
          <header class="cs-head cs-rv">
            <Texto class="cs-num" valor={contenido.problema.numero} />
            <Texto como="h2" class="cs-h" id="h-cs-1" valor={contenido.problema.titulo} />
          </header>
          {contenido.problema.parrafos.map((parrafo) => <Texto class="cs-text cs-rv" valor={parrafo} />)}
          <Texto class="cs-lead cs-rv" valor={contenido.problema.pregunta} />
          <NotaDeCaso texto={contenido.problema.nota} />
        </section>

        {/* ══ 02 · LA INVESTIGACIÓN ══ */}
        <section class="cs-sec" id="cs-2" style="--cs:var(--sky)" aria-labelledby="h-cs-2">
          <header class="cs-head cs-rv">
            <Texto class="cs-num" valor={contenido.investigacion.numero} />
            <Texto como="h2" class="cs-h" id="h-cs-2" valor={contenido.investigacion.titulo} />
          </header>
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.entrada} />

          {/* A · acceso a alimentos */}
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.investigacion.acceso.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.acceso.parrafo} />
          <div class="cs-figs cs-rv">
            <FiguraDeCaso imagen={img('investigacion/mapa-desiertos.webp')} ancho={1100} alto={618} texto={contenido.investigacion.acceso.mapas[0]} />
            <FiguraDeCaso imagen={img('investigacion/mapa-bajos-ingresos.webp')} ancho={1100} alto={618} texto={contenido.investigacion.acceso.mapas[1]} />
          </div>
          <NotaDeCaso texto={contenido.investigacion.acceso.nota} />

          {/* B · condiciones ambientales */}
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.investigacion.ambiente.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.ambiente.parrafo} />
          <div class="cs-figs uno cs-rv">
            <FiguraDeCaso imagen={img('investigacion/mapa-analisis-agricola.webp')} ancho={1100} alto={619} texto={contenido.investigacion.ambiente.panel} />
          </div>
          <div class="cs-figs par cs-rv">
            <FiguraDeCaso imagen={img('investigacion/detalle-vegetacion.webp')} ancho={443} alto={326} texto={contenido.investigacion.ambiente.detalles[0]} />
            <FiguraDeCaso imagen={img('investigacion/detalle-evapotranspiracion.webp')} ancho={214} alto={194} texto={contenido.investigacion.ambiente.detalles[1]} />
          </div>
          <NotaDeCaso texto={contenido.investigacion.ambiente.nota} />

          {/* C · lluvia y temperatura */}
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.investigacion.clima.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.clima.parrafo} />

          {/* Los dos resúmenes anuales de lluvia. --c1/--c2 son las
              proporciones de cada gráfico: así llenan su columna y llegan
              al mismo alto sin bandas blancas a los lados. */}
          <div class="cs-figs par prop cs-rv" style="--c1:1.70fr; --c2:1.47fr">
            <FiguraDeCaso imagen={img('investigacion/precipitacion-anual.webp')} ancho={753} alto={442} texto={contenido.investigacion.clima.lluviaAnual} />
            <FiguraDeCaso imagen={img('investigacion/precipitacion-categorias.webp')} ancho={638} alto={433} texto={contenido.investigacion.clima.lluviaPorCategoria} />
          </div>

          {/* doce meses por año: necesitan todo el ancho para leerse */}
          <div class="cs-figs uno cs-rv">
            <FiguraDeCaso imagen={img('investigacion/precipitacion-mensual.webp')} ancho={846} alto={487} texto={contenido.investigacion.clima.lluviaMensual} />
          </div>
          <div class="cs-figs uno cs-rv">
            <FiguraDeCaso imagen={img('investigacion/temperatura-mensual.webp')} ancho={842} alto={419} texto={contenido.investigacion.clima.temperaturaMensual} />
          </div>

          {/* dos barras ocupan poco: el hueco lateral lo llena la ficha */}
          <div class="cs-duo cs-rv">
            <FiguraDeCaso imagen={img('investigacion/temperatura-estaciones.webp')} ancho={841} alto={423} texto={contenido.investigacion.clima.inviernoVerano} />
            <dl class="cs-ficha">
              {([
                ['variable', 'variable'],
                ['queExploraba', 'queExploraba'],
                ['lectura', 'lectura'],
                ['estado', 'estado'],
              ] as const).map(([campo]) => {
                const etiqueta = conIdioma(contenido.fichaDeVariable.etiquetas[campo]);
                const valor = conIdioma(contenido.fichaDeVariable[campo]);
                return <div><dt {...etiqueta.atributos}>{etiqueta.texto}</dt><dd {...valor.atributos}>{valor.texto}</dd></div>;
              })}
            </dl>
          </div>
          <NotaDeCaso texto={contenido.investigacion.clima.nota} />

          {/* D · de las condiciones a las plantas */}
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.investigacion.plantas.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.plantas.parrafo} />
          <NotaDeCaso texto={contenido.investigacion.plantas.nota} />

          {/* las fuentes documentadas en la presentación */}
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.investigacion.fuentes.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.investigacion.fuentes.parrafo} />
          <ul class="cs-tools cs-rv dos">{fuentesDeDatos.map(([nombre, coleccion]) => (
            <li>{nombre} <span class="cs-src-id">{coleccion}</span></li>
          ))}</ul>
        </section>

        {/* ══ 03 · DEL ENTORNO AL PLATO ══ */}
        <section class="cs-sec" id="cs-3" style="--cs:var(--mint)" aria-labelledby="h-cs-3">
          <header class="cs-head cs-rv">
            <Texto class="cs-num" valor={contenido.propuesta.numero} />
            <Texto como="h2" class="cs-h" id="h-cs-3" valor={contenido.propuesta.titulo} />
          </header>
          <Texto class="cs-text cs-rv" valor={contenido.propuesta.parrafo} />
          <div class="cs-tri cs-rv">{contenido.propuesta.momentos.map((momento) => {
            const nombre = conIdioma(momento.nombre);
            const texto = conIdioma(momento.texto);
            return <div class="cs-tri-c"><h3 {...nombre.atributos}>{nombre.texto}</h3><p {...texto.atributos}>{texto.texto}</p></div>;
          })}</div>
          <Texto como="h3" class="cs-sub-h cs-rv" valor={contenido.propuesta.gamificacion.titulo} />
          <Texto class="cs-text cs-rv" valor={contenido.propuesta.gamificacion.parrafo} />
          <NotaDeCaso texto={contenido.propuesta.nota} />
        </section>

        {/* ══ 04 · LAS PANTALLAS ══ */}
        <section class="cs-sec" id="cs-4" style="--cs:var(--lav)" aria-labelledby="h-cs-4">
          <header class="cs-head cs-rv">
            <Texto class="cs-num" valor={contenido.pantallas.numero} />
            <Texto como="h2" class="cs-h" id="h-cs-4" valor={contenido.pantallas.titulo} />
          </header>
          <Texto class="cs-text cs-rv" valor={contenido.pantallas.parrafos[0]} />
          <Texto class="cs-text cs-rv" html valor={contenido.pantallas.parrafos[1]} />

          <div class="cs-groups">{gruposDePantallas.map((grupo, i) => (
            <GrupoDePantallas
              id={grupo.id}
              lado={grupo.lado}
              color={grupo.color}
              texto={contenido.pantallas.grupos[i]!}
              capturas={grupo.capturas}
            />
          ))}</div>
        </section>

        {/* ══ 05 · LO QUE VIENE ══ */}
        <section class="cs-sec" id="cs-5" style="--cs:var(--lav)" aria-labelledby="h-cs-5">
          <header class="cs-head cs-rv">
            <Texto class="cs-num" valor={contenido.loQueViene.numero} />
            <Texto como="h2" class="cs-h" id="h-cs-5" valor={contenido.loQueViene.titulo} />
          </header>
          {contenido.loQueViene.parrafos.map((parrafo) => <Texto class="cs-text cs-rv" valor={parrafo} />)}
        </section>

        <CierreDeCaso
          texto={contenido.cierre}
          enlaceDelProyecto={EN_DRIVE}
          relacionados={[
            /* interno: es otra página del sitio, así que NO abre pestaña nueva */
            { nombre: 'Schaman Analytics BI', meta: 'Rediseño de Interfaz · 2026',
              enlace: rutaPagina('casos/schaman-analytics-bi'),
              imagen: imagen('images/proyectos/schaman-analytics', 416).src,
              interno: true },
            { nombre: 'Catventures', meta: 'Unity 2D · 2026',
              enlace: 'https://github.com/bypaupau/JuegoGrupal-ProyectoIIParcial',
              imagen: imagen('images/proyectos/catventures', 416).src },
          ]}
        />

      </div>
    </div>
  </div>

  <script>
    import '../../scripts/casos/riel';
  </script>
</BaseLayout>
