---
/* ═══════════════════════════════════════════════════════════
   CASO · SCHAMAN ANALYTICS BI  →  /Portafolio/casos/schaman-analytics-bi

   ── DÓNDE ESTÁ TODO LO DE ESTA PÁGINA ──────────────────────
   contenido   src/content/casos/schaman-analytics-bi.ts  ← TODO el texto
   interfaz    src/i18n/{es,en}/casos.ts                  ← la barra
   estilo      src/styles/casos/caso.css   (compartida con el otro caso)
               └ partes/lectura.css, barra.css y las de cada bloque
   scripts     src/scripts/casos/barra.ts · diagnostico.ts · videos.ts
               · escritura.ts
   piezas      src/components/paginas/casos/
   imágenes    originales/images/casos/schaman-analytics-bi/ → manifiesto
   vídeo       public/video/casos/schaman-analytics-bi/
   URL previa  /pages/caso/schaman-analytics-bi.html → redirige

   ── EL LAYOUT ──────────────────────────────────────────────
   Una barra propia a la izquierda (el índice del caso en línea de
   tiempo) y el contenido en UNA medida de 852 px: texto, títulos y
   evidencia terminan en la misma vertical. Ocho secciones, 00–07, y
   cada una con su acento (--caso-acento), que pinta el filete de su
   encabezado y el sub-índice de su parada:

     00 portada      --pink        04 exploración  --lav
     01 origen       --sky         05 datos        --pink-mid
     02 reto         --peach       06 resultado    --yellow
     03 vistas       --mint        07 aprendizaje  --yellow

   Queda UNA ventana en toda la página, la de la portada, porque lo de
   dentro sí es una ventana de aplicación.

   EL MOVIMIENTO: el título se escribe letra a letra (escritura.ts), cada
   bloque aparece al bajar (.cs-rv) y los vídeos se reproducen solos y en
   bucle al llegar a ellos, como GIFs (videos.ts). Con «menos
   movimiento» no pasa nada de eso: todo está quieto y visible.

   SIN LA BARRA DE ABAJO (sinTaskbar): la página es la versión
   minimalista del caso. El selector de idioma vive en el pie de la
   barra del caso.

   La 02 termina con tres prioridades y la 03, la 04 y la 05 son esas
   tres, en el mismo orden. Si se toca el orden de una, se toca el de
   la otra.

   ── LAS IMÁGENES ───────────────────────────────────────────
   Pasan por el manifiesto, como pide CONVENCIONES §4: los originales
   están en originales/images/casos/schaman-analytics-bi/, npm run
   imagenes genera lo publicado y captura() pide cada una por su
   nombre, sin extensión. Las medidas salen del manifiesto, así que no
   se escriben aquí.

   TODAS las capturas y grabaciones son de la aplicación ejecutándose:
   las de «antes» de la rama main y las de «después» de rediseno-pau,
   contra el mismo almacén.

   data-page va como "caso-schaman" porque hay reglas viejas de CSS que
   dependen de eso (partes/editorial.css y responsive-bloques-nuevos);
   se retiran con el riel en la etapa 6.
   ═══════════════════════════════════════════════════════════ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Texto from '../../components/piezas/Texto.astro';
import BarraDeCaso from '../../components/paginas/casos/BarraDeCaso.astro';
import EncabezadoDeSeccion from '../../components/paginas/casos/EncabezadoDeSeccion.astro';
import FichaDePortada from '../../components/paginas/casos/FichaDePortada.astro';
import VentanaDeCaso from '../../components/paginas/casos/VentanaDeCaso.astro';
import NotaConMascota from '../../components/paginas/casos/NotaConMascota.astro';
import PreguntaDeDiseno from '../../components/paginas/casos/PreguntaDeDiseno.astro';
import MedioDeCaso from '../../components/paginas/casos/MedioDeCaso.astro';
import ParejaDeCaso from '../../components/paginas/casos/ParejaDeCaso.astro';
import SubBloqueDeCaso from '../../components/paginas/casos/SubBloqueDeCaso.astro';
import TiraDeTres from '../../components/paginas/casos/TiraDeTres.astro';
import PantallasFijas from '../../components/paginas/casos/PantallasFijas.astro';
import CierreDeCaso from '../../components/paginas/casos/CierreDeCaso.astro';
import { rutaPublica, rutaPagina } from '../../lib/rutas';
import { imagen } from '../../lib/imagenes';
import { schamanAnalyticsBi as contenido } from '../../content/casos/schaman-analytics-bi';
import '../../styles/casos/caso.css';

const REPOSITORIO = 'https://github.com/bypaupau/Schaman-Analytics-BI/tree/rediseno-pau';
const PROYECTOS = rutaPagina('proyectos');

/* Cada captura, con el ancho y el alto REALES de su archivo, que salen
   del manifiesto. 1704 es el doble de la columna de contenido (852 px);
   las que miden menos se quedan como están, nunca se agrandan. */
const captura = (nombre: string) => {
  const { src, ancho, alto } = imagen('images/casos/schaman-analytics-bi/' + nombre, 1704);
  return { imagen: src, ancho, alto };
};

/* Los vídeos no pasan por el manifiesto: cada .mp4 sale de su .mov de
   originales/video/ con ffmpeg y lleva su póster al lado (ver
   originales/LEEME.md). Las cinco grabaciones miden 1280×610; la
   duración, redondeada al segundo, es la que dice ffprobe. */
const video = (nombre: string, duracion: string) => ({
  video: rutaPublica(`video/casos/schaman-analytics-bi/${nombre}.mp4`),
  poster: rutaPublica(`video/casos/schaman-analytics-bi/${nombre}-poster.webp`),
  ancho: 1280, alto: 610, duracion,
});

const ACENTO = {
  portada: 'var(--pink)', origen: 'var(--sky)', reto: 'var(--peach)', vistas: 'var(--mint)',
  exploracion: 'var(--lav)', datos: 'var(--pink-mid)', resultado: 'var(--yellow)', aprendizaje: 'var(--yellow)',
} as const;

const { indice, etiquetas: ETIQ, portada, origen, reto, vistas, exploracion, datos, resultado, aprendizaje } = contenido;

/* LAS PARADAS DE LA BARRA: una por sección, en el orden de la página.
   La 04 y la 05 llevan su sub-índice, que apunta a sus sub-bloques. */
const PARADAS = [
  { id: 'caso-00', acento: ACENTO.portada },
  { id: 'caso-01', acento: ACENTO.origen },
  { id: 'caso-02', acento: ACENTO.reto },
  { id: 'caso-03', acento: ACENTO.vistas },
  { id: 'caso-04', acento: ACENTO.exploracion, sub: [
    { id: 'caso-04-1', nombre: exploracion.buscar.corto },
    { id: 'caso-04-2', nombre: exploracion.periodo.corto },
    { id: 'caso-04-3', nombre: exploracion.mapa.corto },
  ] },
  { id: 'caso-05', acento: ACENTO.datos, sub: [
    { id: 'caso-05-1', nombre: datos.color.corto },
    { id: 'caso-05-2', nombre: datos.jerarquia.corto },
    { id: 'caso-05-3', nombre: datos.tooltips.corto },
  ] },
  { id: 'caso-06', acento: ACENTO.resultado },
  { id: 'caso-07', acento: ACENTO.aprendizaje },
].map((parada, i) => ({ ...parada, ...indice[i]! }));

/* LA PORTADA, EN DOS COLUMNAS: la ventana a la izquierda y la ficha a
   la derecha, empezando a la misma altura. Su proporción la necesita la
   rejilla para que la ventana entre entera en la pantalla (lectura.css). */
const VENTANA = captura('main-menu');
---

<BaseLayout
  paginaActual="projects"
  paginaDeDatos="caso-schaman"
  claveTitulo="pages.projects.metaTitle"
  claveDescripcion="pages.projects.metaDescription"
  nombreDeVentana={contenido.documento.nombreDeVentana}
  claseBody="cs-body"
  tituloDelCaso={contenido.documento}
  sinTaskbar
>
  <div class="caso-pagina">

    <BarraDeCaso paradas={PARADAS} volver={PROYECTOS} saludo={portada.saludo} />

    <div class="caso-contenido">

      {/* ══ 00 · PORTADA ══ */}
      <header class="caso-portada" id="caso-00" style={`--caso-acento:${ACENTO.portada}`}>
        <Texto class="caso-antetitulo hx" style="--d:100ms" valor={portada.antetitulo} />
        <h1 class="caso-h1 hx" style="--d:170ms" data-escribir>Schaman Analytics BI</h1>
        <Texto class="caso-subtitulo hx" style="--d:240ms" valor={portada.subtitulo} />
        {/* la ventana entra ENTERA en la primera pantalla, con la ficha
            al lado (nunca más alta que ella). El saludo no va aquí: lo dice
            la mascota de la barra, en su bocadillo */}
        <div class="caso-portada-fila hx" style={`--d:300ms;--proporcion:${VENTANA.ancho} / ${VENTANA.alto}`}>
          <VentanaDeCaso nombre={portada.ventana.nombre} {...VENTANA} alt={portada.ventana.alt} pie={portada.ventana.pie} />
          <FichaDePortada campos={portada.ficha} />
        </div>
        {portada.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
      </header>

      {/* ══ 01 · EL ORIGEN ══ */}
      <section class="caso-seccion" id="caso-01" style={`--caso-acento:${ACENTO.origen}`} aria-labelledby="h-caso-01">
        <EncabezadoDeSeccion id="h-caso-01" antetitulo={origen.antetitulo} titulo={origen.titulo} />
        <NotaConMascota texto={origen.nota} />
        {origen.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
        <TiraDeTres elementos={origen.datos} />
        <div class="caso-bloque cs-rv">
          <MedioDeCaso medida="estrecho" imagenes={[{ ...captura('comparacion-panel-antes'), alt: origen.figura.alt }]}
            titulo={origen.figura.titulo} pie={origen.figura.pie} />
        </div>
      </section>

      {/* ══ 02 · EL RETO DE DISEÑO ══ */}
      <section class="caso-seccion" id="caso-02" style={`--caso-acento:${ACENTO.reto}`} aria-labelledby="h-caso-02">
        <EncabezadoDeSeccion id="h-caso-02" antetitulo={reto.antetitulo} titulo={reto.titulo} />
        <Texto html class="caso-texto cs-rv" valor={reto.parrafo} />
        {/* fijo: la columna de la captura se queda quieta y cada llamada
            trae su captura de la versión original */}
        <PantallasFijas pantallas={(['pantalla-completa-inicio-y-sesiones', 'tabla-antes', 'kpis-antes'] as const).map((nombre, i) => {
          const { pie, alt } = reto.diagnostico[i]!;
          return { imagenes: [{ ...captura(nombre), alt }], pie };
        })} />
        <PreguntaDeDiseno rotulo={reto.pregunta.rotulo} texto={reto.pregunta.texto} />
        <Texto class="caso-texto cs-rv" valor={reto.puente} />
        <TiraDeTres variante="acento" elementos={reto.prioridades.map((texto, i) => ({ rotulo: String(i + 1).padStart(2, '0'), texto }))} />
      </section>

      {/* ══ 03 · ORGANIZAR LAS VISTAS · primera decisión ══ */}
      <section class="caso-seccion" id="caso-03" style={`--caso-acento:${ACENTO.vistas}`} aria-labelledby="h-caso-03">
        <EncabezadoDeSeccion id="h-caso-03" antetitulo={vistas.antetitulo} titulo={vistas.titulo} />
        {vistas.parrafos.map((parrafo) => <Texto html class="caso-texto cs-rv" valor={parrafo} />)}
        <Texto como="blockquote" class="caso-cita cs-rv" valor={vistas.cita} />
        <ParejaDeCaso>
          <MedioDeCaso rotulo={ETIQ.antes} tono="antes" video={{ ...video('sesiones-antes', '00:08'), alt: vistas.antes.alt }} pie={vistas.antes.pie} />
          <MedioDeCaso rotulo={ETIQ.despues} video={{ ...video('sesiones-en-otra-pestana', '00:05'), alt: vistas.despues.alt }} pie={vistas.despues.pie} />
        </ParejaDeCaso>
        <Texto html class="caso-texto cs-rv" valor={vistas.cierre} />
      </section>

      {/* ══ 04 · FACILITAR LA EXPLORACIÓN · segunda decisión ══ */}
      <section class="caso-seccion" id="caso-04" style={`--caso-acento:${ACENTO.exploracion}`} aria-labelledby="h-caso-04">
        <EncabezadoDeSeccion id="h-caso-04" antetitulo={exploracion.antetitulo} titulo={exploracion.titulo} />

        <SubBloqueDeCaso id="caso-04-1" numero={1} total={3} titulo={exploracion.buscar.titulo}>
          <Texto html class="caso-texto cs-rv" valor={exploracion.buscar.parrafo} />
          <ParejaDeCaso>
            <MedioDeCaso rotulo={exploracion.buscar.orden.rotulo} video={{ ...video('orden-por-columna', '00:32'), alt: exploracion.buscar.orden.alt }} pie={exploracion.buscar.orden.pie} />
            <MedioDeCaso rotulo={exploracion.buscar.paginacion.rotulo} video={{ ...video('paginacion', '00:22'), alt: exploracion.buscar.paginacion.alt }} pie={exploracion.buscar.paginacion.pie} />
          </ParejaDeCaso>
          <TiraDeTres elementos={exploracion.buscar.tira} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-04-2" numero={2} total={3} titulo={exploracion.periodo.titulo}>
          <Texto html class="caso-texto cs-rv" valor={exploracion.periodo.parrafo} />
          <div class="caso-bloque cs-rv">
            <MedioDeCaso rotulo={ETIQ.antes} tono="antes" imagenes={[{ ...captura('26-filtro-antes'), alt: exploracion.periodo.antes.alt }]} pie={exploracion.periodo.antes.pie} />
          </div>
          <div class="caso-bloque cs-rv">
            <MedioDeCaso rotulo={ETIQ.despues} video={{ ...video('filtro-de-fecha', '00:18'), alt: exploracion.periodo.despues.alt }} pie={exploracion.periodo.despues.pie} />
          </div>
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-04-3" numero={3} total={3} titulo={exploracion.mapa.titulo}>
          <Texto html class="caso-texto cs-rv" valor={exploracion.mapa.parrafo} />
          <div class="caso-bloque cs-rv">
            <MedioDeCaso medida="estrecho" rotulo={exploracion.mapa.rotulo} imagenes={[{ ...captura('12-mapa'), alt: exploracion.mapa.alt }]} pie={exploracion.mapa.pie} />
          </div>
        </SubBloqueDeCaso>
      </section>

      {/* ══ 05 · CLARIFICAR LOS DATOS · tercera decisión ══ */}
      <section class="caso-seccion" id="caso-05" style={`--caso-acento:${ACENTO.datos}`} aria-labelledby="h-caso-05">
        <EncabezadoDeSeccion id="h-caso-05" antetitulo={datos.antetitulo} titulo={datos.titulo} />
        <Texto html class="caso-texto cs-rv" valor={datos.entradilla} />

        <SubBloqueDeCaso id="caso-05-1" numero={1} total={3} titulo={datos.color.titulo}>
          <Texto html class="caso-texto cs-rv" valor={datos.color.parrafo} />
          {/* dos recortes de una columna de la tabla: a su tamaño natural,
              con la explicación en la tercera columna */}
          <ParejaDeCaso conLado>
            <MedioDeCaso medida="natural" rotulo={ETIQ.antes} tono="antes" imagenes={[{ ...captura('16-canal-antes'), alt: datos.color.antes.alt }]} pie={datos.color.antes.pie} />
            <MedioDeCaso medida="natural" rotulo={ETIQ.despues} imagenes={[{ ...captura('17-canal-despues'), alt: datos.color.despues.alt }]} pie={datos.color.despues.pie} />
            <Fragment slot="lado">
              <Texto valor={datos.color.lado} />
              <ul>{datos.color.lista.map((punto) => <Texto como="li" valor={punto} />)}</ul>
            </Fragment>
          </ParejaDeCaso>
          <Texto class="caso-texto caso-centrado cs-rv" valor={datos.color.cierre} />
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-05-2" numero={2} total={3} titulo={datos.jerarquia.titulo}>
          <Texto html class="caso-texto cs-rv" valor={datos.jerarquia.parrafo} />
          {/* el antes y el después, cada uno con el score arriba y la tira
              de cinco tarjetas debajo, como en la aplicación. Son tiras
              muy anchas (≈2800×400): a media columna las tarjetas no se
              distinguen, así que van una encima de otra a lo ancho entero */}
          <div class="caso-bloque cs-rv">
            <MedioDeCaso rotulo={ETIQ.antes} tono="antes"
              imagenes={[{ ...captura('score-global-antiguo'), alt: datos.jerarquia.antes.altScore }, { ...captura('tira-kpi-antigua'), alt: datos.jerarquia.antes.alt }]}
              pie={datos.jerarquia.antes.pie} />
          </div>
          <div class="caso-bloque cs-rv">
            <MedioDeCaso rotulo={ETIQ.despues}
              imagenes={[{ ...captura('score-global-nuevo'), alt: datos.jerarquia.despues.altScore }, { ...captura('tira-kpi-nueva'), alt: datos.jerarquia.despues.alt }]}
              pie={datos.jerarquia.despues.pie} />
          </div>
        </SubBloqueDeCaso>

        <SubBloqueDeCaso id="caso-05-3" numero={3} total={3} titulo={datos.tooltips.titulo}>
          <Texto html class="caso-texto cs-rv" valor={datos.tooltips.parrafo} />
          <ParejaDeCaso>
            <MedioDeCaso medida="natural" rotulo={datos.tooltips.indicador.rotulo} imagenes={[{ ...captura('24-tooltip-indicador'), alt: datos.tooltips.indicador.alt }]} pie={datos.tooltips.indicador.pie} />
            <MedioDeCaso medida="natural" rotulo={datos.tooltips.columna.rotulo} imagenes={[{ ...captura('25-tooltip-columna'), alt: datos.tooltips.columna.alt }]} pie={datos.tooltips.columna.pie} />
          </ParejaDeCaso>
        </SubBloqueDeCaso>
      </section>

      {/* ══ 06 · EL RESULTADO ══ */}
      <section class="caso-seccion" id="caso-06" style={`--caso-acento:${ACENTO.resultado}`} aria-labelledby="h-caso-06">
        <EncabezadoDeSeccion id="h-caso-06" antetitulo={resultado.antetitulo} titulo={resultado.titulo} />
        <Texto html class="caso-texto cs-rv" valor={resultado.parrafo} />
        {/* fija, como el diagnóstico de la 02: la pantalla se queda
            quieta y cambia según la llamada que se lee */}
        <PantallasFijas pantallas={(['main-menu', 'sesiones-tab', 'mapa-tab'] as const).map((nombre, i) => {
          const { titulo, pie, alt } = resultado.pantallas[i]!;
          return { imagenes: [{ ...captura(nombre), alt }], titulo, pie };
        })} />
        <TiraDeTres variante="caja" elementos={resultado.resumen} />
      </section>

      {/* ══ 07 · LO QUE APRENDÍ ══ */}
      <section class="caso-seccion" id="caso-07" style={`--caso-acento:${ACENTO.aprendizaje}`} aria-labelledby="h-caso-07">
        <EncabezadoDeSeccion id="h-caso-07" antetitulo={aprendizaje.antetitulo} titulo={aprendizaje.titulo} />
        <Texto html class="caso-texto cs-rv" valor={aprendizaje.parrafo} />
        <NotaConMascota variante="aviso" rotulo={aprendizaje.aviso.rotulo} texto={aprendizaje.aviso.texto} />
      </section>

      {/* el cierre de siempre: volver, el repositorio en botón pixel y
          los otros proyectos */}
      <div class="cs-rv">
        <CierreDeCaso
          texto={{ volver: contenido.cierre.volver, verProyecto: contenido.cierre.verRepositorio, otrosProyectos: contenido.cierre.otrosProyectos }}
          enlaceDelProyecto={REPOSITORIO}
          claseDelBoton="btn btn-yellow"
          iconoDelBoton={rutaPublica('images/logos/github-icon.png')}
          relacionados={[
            { nombre: 'Grow With Phoenix', meta: 'SpaceHACK · 2025',
              enlace: rutaPagina('casos/grow-with-phoenix'),
              imagen: imagen('images/proyectos/phoenix-grow', 416).src,
              interno: true },
          ]}
        />
      </div>

    </div>
  </div>

  <script>
    import '../../scripts/casos/barra';
    import '../../scripts/casos/nav-al-leer';
    import '../../scripts/casos/escritura';
    import '../../scripts/casos/portada';
    import '../../scripts/casos/diagnostico';
    import '../../scripts/casos/videos';
  </script>
</BaseLayout>
