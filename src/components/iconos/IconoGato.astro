---
/* Un gato. 9×9 px.
   Datos copiados sin cambios del objeto SEAL['s-lav'] que vivía como
   cadena de JavaScript dentro de pages/proyectos.html. */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
---
<svg class={clase} style="--gw:9;--gh:9" viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="0" y="0" width="1" height="1" fill="var(--ink)"/>
  <rect x="6" y="0" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="1" width="2" height="1" fill="var(--ink)"/>
  <rect x="5" y="1" width="2" height="1" fill="var(--ink)"/>
  <rect x="0" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="2" width="1" height="1" fill="var(--lav)"/>
  <rect x="2" y="2" width="3" height="1" fill="var(--ink)"/>
  <rect x="5" y="2" width="1" height="1" fill="var(--lav)"/>
  <rect x="6" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="5" height="1" fill="var(--lav)"/>
  <rect x="6" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="4" width="1" height="1" fill="var(--lav)"/>
  <rect x="2" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="4" width="1" height="1" fill="var(--lav)"/>
  <rect x="4" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="4" width="1" height="1" fill="var(--lav)"/>
  <rect x="6" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="5" width="2" height="1" fill="var(--lav)"/>
  <rect x="3" y="5" width="1" height="1" fill="var(--pink)"/>
  <rect x="4" y="5" width="2" height="1" fill="var(--lav)"/>
  <rect x="6" y="5" width="2" height="1" fill="var(--ink)"/>
  <rect x="1" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="6" width="4" height="1" fill="var(--lav)"/>
  <rect x="6" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="7" width="4" height="1" fill="var(--lav)"/>
  <rect x="6" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="8" width="1" height="1" fill="var(--lav)"/>
  <rect x="3" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="4" y="8" width="1" height="1" fill="var(--lav)"/>
  <rect x="5" y="8" width="3" height="1" fill="var(--ink)"/>
</svg>
