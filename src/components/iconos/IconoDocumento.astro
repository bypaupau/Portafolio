---
/* Una hoja con la esquina doblada y tres renglones. 8×9 px.
   Va en el botón "ir al caso" de las tarjetas de Proyectos: el caso de
   estudio es el documento. Mide 9 px de alto, como IconoCarpeta, para
   que los dos botones queden a la misma altura. */
interface Props { class?: string; ancho?: string }
const { class: clase = 'sprite', ancho = '16' } = Astro.props;
---
<svg
  class={clase}
  viewBox="0 0 8 9"
  width={ancho}
  xmlns="http://www.w3.org/2000/svg"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <path fill="var(--ink)" d="M0 0h6v1H0zM0 1h1v8H0zM1 8h7v1H1zM6 1h1v1H6zM7 2h1v6H7zM5 1h1v1H5zM5 2h2v1H5z"/>
  <path fill="var(--white)" d="M1 1h4v7H1zM5 3h2v5H5z"/>
  <path fill="var(--pink)" d="M2 4h3v1H2zM2 6h4v1H2z"/>
</svg>
