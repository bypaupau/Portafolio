---
/* La ventanita de la taskbar, a la izquierda del nombre de la página. 9×8 px. */
interface Props { class?: string }
const { class: clase = 'tb-app-ico' } = Astro.props;
---
<svg class={clase} viewBox="0 0 9 8" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <path fill="var(--ink)" d="M0 0h9v8H0z"/>
  <path fill="var(--pink-light)" d="M1 1h7v1H1z"/>
  <path fill="var(--white)" d="M1 3h7v4H1z"/>
  <path fill="var(--pink)" d="M6 1h1v1H6zM2 4h3v1H2zM2 5h2v1H2z"/>
</svg>
