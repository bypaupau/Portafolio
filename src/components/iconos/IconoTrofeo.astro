---
/* Un trofeo. 9×10 px.
   Datos copiados sin cambios del objeto SEAL['s-gold'] que vivía como
   cadena de JavaScript dentro de pages/proyectos.html. */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
---
<svg class={clase} style="--gw:9;--gh:10" viewBox="0 0 9 10" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="1" y="0" width="7" height="1" fill="var(--ink)"/>
  <rect x="0" y="1" width="2" height="1" fill="var(--ink)"/>
  <rect x="2" y="1" width="5" height="1" fill="var(--dib-oro)"/>
  <rect x="7" y="1" width="2" height="1" fill="var(--ink)"/>
  <rect x="0" y="2" width="2" height="1" fill="var(--ink)"/>
  <rect x="2" y="2" width="5" height="1" fill="var(--dib-oro)"/>
  <rect x="7" y="2" width="2" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="3" width="5" height="1" fill="var(--dib-oro)"/>
  <rect x="7" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="4" width="3" height="1" fill="var(--dib-oro)"/>
  <rect x="6" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="4" y="5" width="1" height="1" fill="var(--dib-oro)"/>
  <rect x="5" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="4" y="6" width="1" height="1" fill="var(--dib-oro)"/>
  <rect x="5" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="7" width="5" height="1" fill="var(--ink)"/>
  <rect x="2" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="8" width="3" height="1" fill="var(--dib-oro)"/>
  <rect x="6" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="9" width="5" height="1" fill="var(--ink)"/>
</svg>
