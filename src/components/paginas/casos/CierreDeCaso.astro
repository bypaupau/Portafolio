---
/* ═══════════════════════════════════════════════════════════
   EL CIERRE DE UN CASO · <footer class="cs-out">

   Dos botones (volver a proyectos · ver el proyecto) y dos tarjetitas
   de otros proyectos. Igual en los dos casos, con sus propios datos.
   ═══════════════════════════════════════════════════════════ */
import { conIdioma } from '../../../lib/texto-bilingue';
import type { TextoBilingue } from '../../../lib/texto-bilingue';
import { rutaPagina } from '../../../lib/rutas';

interface Props {
  texto: { volver: TextoBilingue; verProyecto: TextoBilingue; otrosProyectos: TextoBilingue };
  enlaceDelProyecto: string;
  /** por defecto el botón rosa; Schaman usa el amarillo con el logo */
  claseDelBoton?: string;
  /** si va, el botón lleva ese icono delante del texto */
  iconoDelBoton?: string;
  /** los nombres y las fechas no se traducen: son nombres propios.
      `interno` para un enlace del propio sitio (no abre otra pestaña) */
  relacionados: readonly {
    nombre: string; meta: string; enlace: string; imagen: string; interno?: boolean;
  }[];
}
const {
  texto, enlaceDelProyecto, relacionados,
  claseDelBoton = 'btn btn-primary', iconoDelBoton,
} = Astro.props;
const volver = conIdioma(texto.volver);
const ver = conIdioma(texto.verProyecto);
const otros = conIdioma(texto.otrosProyectos);
---
<footer class="cs-out">
  <div class="cs-out-row">
    <a class="btn btn-ghost" href={rutaPagina('proyectos')} {...volver.atributos}>{volver.texto}</a>
    {/* CON icono, el texto va en su propio <span> (así lo pide .btn-ico).
        SIN icono, el texto va DIRECTO en el <a>, como en el caso de Phoenix:
        envolverlo en un <span> cambia el alto del botón y la página entera
        se corre unos píxeles. Ya me pasó. */}
    {iconoDelBoton ? (
      <a class={claseDelBoton} target="_blank" rel="noopener" href={enlaceDelProyecto}><span class="btn-ico" aria-hidden="true"><img src={iconoDelBoton} alt="" width="20" height="20" loading="lazy" decoding="async" /></span><span {...ver.atributos}>{ver.texto}</span></a>
    ) : (
      <a class={claseDelBoton} target="_blank" rel="noopener" href={enlaceDelProyecto} {...ver.atributos}>{ver.texto}</a>
    )}
  </div>
  <p class="sec-label" {...otros.atributos}>{otros.texto}</p>
  <div class="cs-rel">
    {relacionados.map((proyecto) => (
      <a href={proyecto.enlace} {...proyecto.interno ? {} : { target: '_blank', rel: 'noopener' }}>
        <img src={proyecto.imagen} alt="" loading="lazy" decoding="async" width="64" height="46" />
        <span><b>{proyecto.nombre}</b><span>{proyecto.meta}</span></span>
      </a>
    ))}
  </div>
</footer>
