---
/* ═══════════════════════════════════════════════════════════
   UNA COMPARACIÓN ANTES / DESPUÉS · <div class="cs-ab">

   Dos capturas del mismo panel, cada una con su etiqueta ("Antes" /
   "Después") y su pie. Es lo propio del caso de Schaman, donde el
   trabajo fue rediseñar algo que ya existía.
   ═══════════════════════════════════════════════════════════ */
import { conIdioma, altConIdioma } from '../../../lib/texto-bilingue';
import type { TextoBilingue } from '../../../lib/texto-bilingue';

interface Props {
  id: string;
  color: string;
  etiquetaAntes: TextoBilingue;
  etiquetaDespues: TextoBilingue;
  texto: {
    titulo: TextoBilingue;
    antes: { pie: TextoBilingue; alt: TextoBilingue };
    despues: { pie: TextoBilingue; alt: TextoBilingue };
  };
  antes: { imagen: string; ancho: number; alto: number };
  despues: { imagen: string; ancho: number; alto: number };
}
const { id, color, etiquetaAntes, etiquetaDespues, texto, antes, despues } = Astro.props;
const titulo = conIdioma(texto.titulo);
const marcaAntes = conIdioma(etiquetaAntes);
const marcaDespues = conIdioma(etiquetaDespues);
const pieAntes = conIdioma(texto.antes.pie);
const pieDespues = conIdioma(texto.despues.pie);
---
<section class="cs-g" style={`--g:${color}`} aria-labelledby={`h-${id}`}>
  <h3 class="cs-g-h" id={`h-${id}`} {...titulo.atributos}>{titulo.texto}</h3>
  <div class="cs-ab">
    <figure class="cs-fig2">
      <span class="cs-ab-k k-a" {...marcaAntes.atributos}>{marcaAntes.texto}</span>
      <img src={antes.imagen} width={antes.ancho} height={antes.alto} loading="lazy" decoding="async" {...altConIdioma(texto.antes.alt)} />
      <figcaption {...pieAntes.atributos}>{pieAntes.texto}</figcaption>
    </figure>
    <figure class="cs-fig2">
      <span class="cs-ab-k k-b" {...marcaDespues.atributos}>{marcaDespues.texto}</span>
      <img src={despues.imagen} width={despues.ancho} height={despues.alto} loading="lazy" decoding="async" {...altConIdioma(texto.despues.alt)} />
      <figcaption {...pieDespues.atributos}>{pieDespues.texto}</figcaption>
    </figure>
  </div>
</section>
