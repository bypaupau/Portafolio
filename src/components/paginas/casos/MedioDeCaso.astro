---
/* ═══════════════════════════════════════════════════════════
   UN MEDIO DEL CASO · <figure class="caso-figura">

   Una captura (o varias apiladas) o un vídeo, con lo que lo acompaña:
   el rótulo en la esquina (ANTES, DESPUÉS, ORDENAR…), la duración
   debajo si es un vídeo, y el pie.

   ── LA REGLA DE LOS MEDIOS ─────────────────────────────────
   Nunca más ancho que el texto. Uno más estrecho va CENTRADO:
     completo   a los 852 px de la columna
     estrecho   centrado, a unos 2/3 de la columna: una pantalla de contexto
     natural    a su tamaño real (la mitad de sus píxeles, porque
                están hechos para pantallas retina) y centrado: un
                recorte de una columna no se estira a media página

   ── LOS VÍDEOS ─────────────────────────────────────────────
   Como GIFs: al llegar a uno se reproduce solo, mudo y en bucle (lo
   hace src/scripts/casos/videos.ts). Con «menos movimiento» no arranca
   solo y queda el botón de reproducir de 60 px; sin JavaScript, los
   controles del navegador. Sin barra de título: la única ventana de
   la página es la de la portada.
   ═══════════════════════════════════════════════════════════ */
import Texto from '../../piezas/Texto.astro';
import { altConIdioma, enIdioma } from '../../../lib/texto-bilingue';
import type { TextoBilingue } from '../../../lib/texto-bilingue';
import { translate } from '../../../i18n/translate';

interface Imagen { imagen: string; ancho: number; alto: number; alt: TextoBilingue }
interface Video {
  video: string; poster: string; ancho: number; alto: number;
  /** «00:22», a la vista bajo el vídeo */
  duracion: string;
  /** qué enseña: lo dice el botón de reproducir */
  alt: TextoBilingue;
}
interface Props {
  imagenes?: readonly Imagen[];
  video?: Video;
  /** la etiqueta de la esquina */
  rotulo?: TextoBilingue;
  /** antes: blanca · después: el acento de la sección */
  tono?: 'antes' | 'despues';
  titulo?: TextoBilingue;
  pie?: TextoBilingue;
  medida?: 'completo' | 'estrecho' | 'natural';
  carga?: 'lazy' | 'eager';
}
const { imagenes = [], video, rotulo, tono = 'despues', titulo, pie, medida = 'completo', carga = 'lazy' } = Astro.props;
/* a su tamaño natural: la mitad de sus píxeles */
const anchoNatural = medida === 'natural'
  ? Math.max(...(video ? [video.ancho] : imagenes.map((i) => i.ancho))) / 2
  : null;
/* «La primera versión. Un detalle…» ya trae su punto; «Panel general»
   no, y entonces lo separa un punto medio: «Panel general · score…» */
const separador = titulo && /[.:!?]$/.test(enIdioma(titulo)) ? ' ' : ' · ';
/* el nombre accesible del vídeo (se puede enfocar para pausarlo): el
   mismo texto del botón, por id. Sale del nombre del archivo, que es
   único en la página. */
const idDelVideo = video ? `video-${video.video.split('/').pop()!.replace(/\.mp4$/, '')}` : '';
---
<figure class:list={['caso-figura', `es-${medida}`, video && 'es-video']}
  style={anchoNatural ? `--ancho-natural:${anchoNatural}px` : undefined}>
  <div class="caso-figura-marco">
    {rotulo && <Texto como="span" class:list={['caso-sello', `es-${tono}`]} valor={rotulo} />}
    {imagenes.map((img) => (
      <img src={img.imagen} width={img.ancho} height={img.alto} loading={carga} decoding="async" {...altConIdioma(img.alt)} />
    ))}
    {video && (<>
      <video src={video.video} poster={video.poster} width={video.ancho} height={video.alto}
        preload="metadata" playsinline muted loop controls aria-labelledby={idDelVideo}></video>
      <button class="caso-video-boton" type="button" hidden>
        <span class="sr-only" id={idDelVideo}><span data-i18n="cases.video.play">{translate('cases.video.play')}</span>{' '}<Texto como="span" valor={video.alt} /></span>
        <svg viewBox="0 0 7 8" width="18" height="20" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
          <path fill="var(--ink)" d="M0 0h2v8H0zM2 1h2v6H2zM4 2h2v4H4zM6 3h1v2H6z"/>
        </svg>
      </button>
    </>)}
  </div>
  {video && <p class="caso-duracion" aria-hidden="true">{video.duracion}</p>}
  {(titulo || pie) && (
    <figcaption>
      {titulo && <Texto como="b" valor={titulo} />}
      {titulo && pie && separador}
      {pie && <Texto como="span" valor={pie} />}
    </figcaption>
  )}
</figure>
