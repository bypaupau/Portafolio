---
/* Icono «panel lateral»: un marco con su columna de navegación a un
   lado. Es el de la decisión 01 del caso de Schaman.

   Trazo de Lucide (lucide.dev · licencia ISC · v1.61.0, icono
   `panel-left`), copiado tal cual: lienzo de 24×24, grosor 2 y
   extremos redondos. Los cinco iconos de las decisiones comparten esas
   tres medidas, que es lo que los hace verse de la misma familia.

   NO lleva shape-rendering="crispEdges": eso es de los sprites pixel de
   components/iconos/, y estos son de trazo.

   El color viene de currentColor, así que lo pone el CSS con un token y
   aquí no hay ni un hexadecimal (§6). */
interface Props { class?: string }
const { class: clase } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect width="18" height="18" x="3" y="3" rx="2" />
  <path d="M9 3v18" />
</svg>
