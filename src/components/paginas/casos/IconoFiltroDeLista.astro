---
/* Icono «filtro de lista»: tres renglones que se van estrechando, como
   una lista que se acota. Es el de la decisión 03, explorar sesiones.

   Trazo de Lucide (lucide.dev · licencia ISC · v1.61.0, icono
   `list-filter`), copiado tal cual: 24×24, grosor 2, extremos redondos.

   Sin crispEdges y sin hexadecimales: el color entra por currentColor. */
interface Props { class?: string }
const { class: clase } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <path d="M2 5h20" />
  <path d="M6 12h12" />
  <path d="M9 19h6" />
</svg>
