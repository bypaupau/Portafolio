  <rect x="2" y="6" width="2" height="1" fill="var(--dib-oro)"/>
  <rect x="4" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="6" width="2" height="1" fill="var(--dib-oro)"/>
  <rect x="7" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="7" width="1" height="1" fill="var(--dib-oro)"/>
