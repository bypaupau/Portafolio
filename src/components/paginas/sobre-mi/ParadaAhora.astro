  <rect x="4" y="0" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="4" y="1" width="1" height="1" fill="var(--dib-oro)"/>
  <rect x="5" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="2" width="4" height="1" fill="var(--ink)"/>
  <rect x="4" y="2" width="2" height="1" fill="var(--dib-oro)"/>
  <rect x="6" y="2" width="3" height="1" fill="var(--ink)"/>
  <rect x="0" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="7" height="1" fill="var(--dib-oro)"/>
  <rect x="8" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="4" width="1" height="1" fill="var(--ink)"/>
