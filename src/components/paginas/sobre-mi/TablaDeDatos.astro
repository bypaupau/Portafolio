---
/* Una tabla con su cabecera y una celda marcada. 11×9 px.
   Uno de los objetos de "analizar" en la caja de herramientas de 02. */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
---
<svg class={clase} style="--gw:11;--gh:9" viewBox="0 0 11 9" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="0" y="0" width="11" height="1" fill="var(--ink)"/>
  <rect x="0" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="1" width="9" height="1" fill="var(--dib-verde)"/>
  <rect x="10" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="2" width="11" height="1" fill="var(--ink)"/>
  <rect x="0" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="3" height="1" fill="var(--white)"/>
  <rect x="4" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="3" width="2" height="1" fill="var(--white)"/>
  <rect x="7" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="3" width="2" height="1" fill="var(--white)"/>
  <rect x="10" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="4" width="3" height="1" fill="var(--white)"/>
  <rect x="4" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="4" width="2" height="1" fill="var(--dib-celeste)"/>
  <rect x="7" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="4" width="2" height="1" fill="var(--white)"/>
  <rect x="10" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="5" width="11" height="1" fill="var(--ink)"/>
  <rect x="0" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="6" width="3" height="1" fill="var(--white)"/>
  <rect x="4" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="6" width="2" height="1" fill="var(--white)"/>
  <rect x="7" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="6" width="2" height="1" fill="var(--white)"/>
  <rect x="10" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="7" width="3" height="1" fill="var(--white)"/>
  <rect x="4" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="5" y="7" width="2" height="1" fill="var(--white)"/>
  <rect x="7" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="7" width="2" height="1" fill="var(--white)"/>
  <rect x="10" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="8" width="11" height="1" fill="var(--ink)"/>
</svg>
