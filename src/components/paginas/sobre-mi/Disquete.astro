---
/* Un disquete de 3,5 pulgadas: la tapa metálica arriba y la etiqueta
   abajo. 11×11 px.
   Uno de los objetos de "construir" en la caja de herramientas de 02. */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
