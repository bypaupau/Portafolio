  <rect x="0" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="4" width="9" height="1" fill="var(--sky)"/>
  <rect x="10" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="5" width="1" height="1" fill="var(--ink)"/>
