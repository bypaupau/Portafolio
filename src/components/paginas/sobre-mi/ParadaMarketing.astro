  <rect x="8" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="3" width="3" height="1" fill="var(--ink)"/>
  <rect x="3" y="3" width="5" height="1" fill="var(--sky)"/>
  <rect x="8" y="3" width="1" height="1" fill="var(--ink)"/>
