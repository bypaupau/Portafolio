---
/* Una carpeta abierta de lado: el panel de atrás amarillo y el de
   adelante durazno. 18×11 px.
   Es el ancla de la caja de herramientas de 02 · con qué trabajo: lo que
   se coloca DETRÁS del panel de adelante se lee como "todavía dentro". */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
---
<svg class={clase} style="--gw:18;--gh:11" viewBox="0 0 18 11" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="2" y="0" width="4" height="1" fill="var(--ink)"/>
  <rect x="1" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="1" width="4" height="1" fill="var(--yellow)"/>
  <rect x="6" y="1" width="10" height="1" fill="var(--ink)"/>
  <rect x="1" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="2" width="14" height="1" fill="var(--yellow)"/>
  <rect x="16" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="3" width="14" height="1" fill="var(--yellow)"/>
  <rect x="16" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="4" width="18" height="1" fill="var(--ink)"/>
  <rect x="0" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="5" width="16" height="1" fill="var(--peach)"/>
  <rect x="17" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="6" width="16" height="1" fill="var(--peach)"/>
  <rect x="17" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="7" width="16" height="1" fill="var(--peach)"/>
  <rect x="17" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="8" width="16" height="1" fill="var(--peach)"/>
  <rect x="17" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="9" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="9" width="16" height="1" fill="var(--peach)"/>
  <rect x="17" y="9" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="10" width="18" height="1" fill="var(--ink)"/>
</svg>
