---
/* Una lupa pixel: el aro celeste, el cristal claro y su brillo. 10×10 px.
   Uno de los objetos de "analizar" en la caja de herramientas de 02.
   No es iconos/IconoLupa: ese es de TRAZO y dice que una imagen se puede
   ampliar. Este es un sprite y es decoración, por eso vive aquí. */
interface Props { class?: string }
const { class: clase = 'px' } = Astro.props;
---
<svg class={clase} style="--gw:10;--gh:10" viewBox="0 0 10 10" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect x="2" y="0" width="4" height="1" fill="var(--ink)"/>
  <rect x="1" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="1" width="4" height="1" fill="var(--dib-celeste)"/>
  <rect x="6" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="2" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="2" y="2" width="1" height="1" fill="var(--white)"/>
  <rect x="3" y="2" width="3" height="1" fill="var(--pink-light)"/>
  <rect x="6" y="2" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="7" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="2" y="3" width="4" height="1" fill="var(--pink-light)"/>
  <rect x="6" y="3" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="7" y="3" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="4" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="2" y="4" width="4" height="1" fill="var(--pink-light)"/>
  <rect x="6" y="4" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="7" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="5" width="4" height="1" fill="var(--dib-celeste)"/>
  <rect x="6" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="6" width="5" height="1" fill="var(--ink)"/>
  <rect x="5" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="6" y="7" width="2" height="1" fill="var(--dib-celeste)"/>
  <rect x="8" y="7" width="1" height="1" fill="var(--ink)"/>
  <rect x="6" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="7" y="8" width="1" height="1" fill="var(--dib-celeste)"/>
  <rect x="8" y="8" width="1" height="1" fill="var(--ink)"/>
  <rect x="7" y="9" width="2" height="1" fill="var(--ink)"/>
</svg>
