  <rect x="8" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="9" y="4" width="2" height="1" fill="var(--pink)"/>
  <rect x="11" y="4" width="1" height="1" fill="var(--ink)"/>
  <rect x="0" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="5" width="2" height="1" fill="var(--pink)"/>
  <rect x="3" y="5" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="5" width="1" height="1" fill="var(--ink)"/>
