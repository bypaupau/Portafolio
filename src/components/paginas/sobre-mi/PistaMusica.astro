  <rect x="3" y="0" width="6" height="1" fill="var(--ink)"/>
  <rect x="2" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="3" y="1" width="6" height="1" fill="var(--sky)"/>
  <rect x="9" y="1" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="2" y="2" width="1" height="1" fill="var(--sky)"/>
  <rect x="3" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="8" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="9" y="2" width="1" height="1" fill="var(--sky)"/>
  <rect x="10" y="2" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="3" width="2" height="1" fill="var(--ink)"/>
  <rect x="9" y="3" width="2" height="1" fill="var(--ink)"/>
