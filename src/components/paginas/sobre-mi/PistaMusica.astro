  <rect x="9" y="6" width="2" height="1" fill="var(--pink)"/>
  <rect x="11" y="6" width="1" height="1" fill="var(--ink)"/>
  <rect x="1" y="7" width="2" height="1" fill="var(--ink)"/>
  <rect x="9" y="7" width="2" height="1" fill="var(--ink)"/>
</svg>
