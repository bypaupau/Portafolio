---
/* Un sobre de carta. 12×8 px.
   Inicio lo usa dos veces y el sitio anterior lo tenía escrito dos
   veces, con los mismos siete rectángulos exactos. Lo que SÍ cambiaba
   entre los dos eran los atributos, así que ahora llegan como props:

     botón de email  <Sobre />                   sin ancho, sin aria
     cierre          <Sobre ancho="42" decorativo />
*/
interface Props {
  class?: string;
  /** atributo width, en px. Sin él, lo dimensiona el CSS. */
  ancho?: string;
  /** lo esconde de lectores de pantalla, cuando el texto de al lado ya lo dice */
  decorativo?: boolean;
}
const { class: clase = 'sprite', ancho, decorativo = false } = Astro.props;
---
<svg
  class={clase}
  viewBox="0 0 12 8"
  width={ancho}
  xmlns="http://www.w3.org/2000/svg"
  shape-rendering="crispEdges"
  aria-hidden={decorativo ? 'true' : undefined}
  focusable={decorativo ? 'false' : undefined}
>
  <rect x="0" y="1" width="12" height="6" fill="var(--ink)"/>
                  <rect x="1" y="2" width="10" height="4" fill="var(--white)"/>
                  <rect x="1" y="2" width="2" height="1" fill="var(--ink)"/>
  <rect x="3" y="3" width="2" height="1" fill="var(--ink)"/>
                  <rect x="5" y="4" width="2" height="1" fill="var(--ink)"/>
  <rect x="7" y="3" width="2" height="1" fill="var(--ink)"/>
                  <rect x="9" y="2" width="2" height="1" fill="var(--ink)"/>
</svg>
